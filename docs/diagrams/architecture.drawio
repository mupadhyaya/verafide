<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram name="Verafide - Privacy Architecture" id="verafide-privacy-arch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Zone backgrounds -->
        <mxCell id="bgClientA" value="User's Phone A &#10;(Profile Owner)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=14;fontStyle=1;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="300" height="420" as="geometry" />
        </mxCell>
        <mxCell id="bgClientB" value="User's Phone B &#10;(Viewer, after match)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=14;fontStyle=1;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="300" height="280" as="geometry" />
        </mxCell>
        <mxCell id="cloudInternet" value="Internet&#10;(all traffic TLS-encrypted in transit)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="360" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="bgServer" value="Main Server &#8212; Postgres + PostGIS&#10;(hosting decision deferred to Phase 5: ResellerClub VPS / Supabase Cloud / Hybrid)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=14;fontStyle=1;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="40" width="380" height="740" as="geometry" />
        </mxCell>
        <mxCell id="bgExternal" value="External Services&#10;(third-party, transient access only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontSize=14;fontStyle=1;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="40" width="300" height="740" as="geometry" />
        </mxCell>

        <!-- Client A nodes -->
        <mxCell id="nodeCamera" value="Camera + On-Device Liveness /&#10;Face-Match SDK&#10;(FaceOnLive / FacePlugin candidates)&#10;selfie never leaves the phone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nodeEncrypt" value="Local Encryption Module&#10;(libsodium, AES-256-GCM,&#10;random per-photo key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nodeGuardA" value="Screenshot Guard&#10;(Android FLAG_SECURE /&#10;iOS secure-layer render trick)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nodeCacheA" value="Local Cache&#10;(expo-sqlite / MMKV, or IndexedDB on web)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nodeAlbumOwner" value="Album Policy Control&#10;(public: auto-grant on match&#10;private: owner approves each viewer)&#10;view-duration: unlimited / once / N sec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- Client B nodes -->
        <mxCell id="nodeUnwrap" value="Key Unwrap + Local Decrypt&#10;(only ever happens on this device)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="550" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nodeGuardB" value="Screenshot Guard&#10;(Android FLAG_SECURE /&#10;iOS secure-layer render trick)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="630" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nodeTimer" value="View-duration timer&#10;deletes local plaintext + key on expiry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="710" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- Server nodes -->
        <mxCell id="nodeAuth" value="Auth &amp; Verification Attestations&#10;(pass/fail only &#8212; no biometric data stored)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="90" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="nodeBlobs" value="Encrypted Photo Blobs&#10;(ciphertext only &#8212; Invariant 3: no plaintext at rest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="160" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="nodeGrants" value="Key Grants&#10;(album + view-duration policy &#8212; Invariant 4: server-enforced, not client-only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="230" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="nodeMatches" value="Matches &amp; Chat Metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="300" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nodeReports" value="Reports &amp; Key-Escrow Log&#10;(report-triggered reveal, audit-logged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="365" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nodeEdgeFn1" value="Edge Function: verification-webhook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="430" width="340" height="45" as="geometry" />
        </mxCell>
        <mxCell id="nodeEdgeFn2" value="Edge Function: moderation-webhook&#10;(transient decrypt &#8594; scan &#8594; discard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="490" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="nodeRLS" value="Row-Level Security&#10;enforces Invariants 1, 3, 4 on every query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="565" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nodePostGIS" value="PostGIS extension&#10;(geospatial proximity matching &#8212; $0, open-source)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="635" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nodeInfra" value="infra/ (Docker Compose, backups)&#10;only if ResellerClub self-hosting is chosen" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="705" width="340" height="50" as="geometry" />
        </mxCell>

        <!-- External nodes -->
        <mxCell id="nodeKYC" value="KYC Document-Check Vendor&#10;Didit &#8212; free forever, 500/mo, $0&#10;(Veriff ~$0.80/verif. as paid fallback past 500/mo)&#10;ID image sent once, no-retention required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="90" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="nodeMod" value="Moderation API&#10;(Sightengine / AWS Rekognition,&#10;~$1-3 per 1,000 images)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="190" width="260" height="65" as="geometry" />
        </mxCell>
        <mxCell id="nodeCDN" value="CDN (optional, e.g. Cloudflare)&#10;caches ciphertext only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="285" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="nodePush" value="Push Notification Service&#10;(Expo Push / APNs / FCM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="370" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="nodeAppStores" value="App Store / Play Store&#10;submission, review, UGC policy (Guideline 1.2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="455" width="260" height="55" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend&#10;Green = trusted client device (plaintext exists here only)&#10;Blue = main server (ciphertext + metadata only)&#10;Orange = third parties (transient access, no retention)&#10;Yellow = enforcement layer (RLS invariants)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="&#9312; signed attestation (pass/fail only)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="nodeCamera" target="nodeAuth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="&#9312;a ID document image (once, transient)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="nodeCamera" target="nodeKYC">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="verdict only, no image retained" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="nodeKYC" target="nodeAuth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="&#9313; upload encrypted photo (ciphertext)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="nodeEncrypt" target="nodeBlobs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="&#9313;a transient decrypt for automated scan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="nodeBlobs" target="nodeMod">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="verdict; plaintext discarded immediately" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="nodeMod" target="nodeBlobs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="cache ciphertext (optional)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="nodeBlobs" target="nodeCDN">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="&#9314; request photo (server checks key-grant policy)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="nodeUnwrap" target="nodeGrants">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="&#9315; ciphertext + wrapped key (if policy allows)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="nodeGrants" target="nodeUnwrap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="&#9316; decrypt locally; screenshot guard active" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="nodeUnwrap" target="nodeTimer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="expiry also enforced server-side" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="nodeTimer" target="nodeGrants">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="album/view-duration policy set here" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="nodeAlbumOwner" target="nodeGrants">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="reporting reveals a key (audit-logged)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="nodeReports" target="nodeBlobs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="match / grant / report events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="nodeMatches" target="nodePush">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="push notification" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="nodePush" target="nodeCacheA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" value="push notification" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="nodePush" target="nodeGuardB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
